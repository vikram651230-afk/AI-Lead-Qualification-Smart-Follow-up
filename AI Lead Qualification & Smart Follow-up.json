      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst name = String(body.name || '').trim();\nconst email = String(body.email || '').trim().toLowerCase();\nconst phone = String(body.phone || '').trim();\nconst company = String(body.company || '').trim();\nconst message = String(body.message || '').trim();\n\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst phoneOk = phone === '' || /^[0-9+()\\-\\s.]{6,20}$/.test(phone);\n\nconst valid = name.length > 0 && emailOk && phoneOk;\nlet invalidReason = '';\nif (!name) invalidReason = 'Missing name';\nelse if (!emailOk) invalidReason = 'Invalid email address';\nelse if (!phoneOk) invalidReason = 'Invalid phone number';\n\nreturn {\n  json: {\n    valid,\n    invalidReason,\n    name,\n    email,\n    phone,\n    company,\n    message,\n    capturedAt: new Date().toISOString(),\n  },\n};"
      },
