    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Validate Lead').item.json;\nlet parsed = {};\nconst content = $json.content ?? $json.text ?? '';\nif (typeof content === 'object' && content !== null) {\n  parsed = content;\n} else {\n  try {\n    parsed = JSON.parse(String(content).replace(/^```json\\s*|\\s*```$/g, '').trim());\n  } catch (e) {\n    parsed = {};\n  }\n}\nlet score = Number(parsed.score);\nif (!Number.isFinite(score)) score = 0;\nscore = Math.max(0, Math.min(100, Math.round(score)));\n\nlet category = 'Cold';\nif (score >= 70) category = 'Hot';\nelse if (score >= 40) category = 'Warm';\n\nreturn {\n  json: {\n    name: lead.name,\n    email: lead.email,\n    phone: lead.phone,\n    company: lead.company,\n    message: lead.message,\n    capturedAt: lead.capturedAt,\n    score,\n    category,\n    reason: parsed.reason || '',\n    followup_subject: parsed.followup_subject || ('Following up, ' + lead.name.split(' ')[0]),\n    followup_body: parsed.followup_body || ('Hi ' + lead.name.split(' ')[0] + ', thanks for your interest. I would love to schedule a quick call to discuss how we can help. Reply to this email and we will set up a time.'),\n  },\n};"
      },
